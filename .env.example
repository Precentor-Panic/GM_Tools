# Copy this file to .env (already gitignored) and fill in a real key.
# Get one from https://console.anthropic.com/ — create a project-scoped key
# with a spend limit set, per GM_Tools' own conventions on this.
#
# Used by: mutation-engine/texture.mjs, time-skip/resolve-seed.mjs (via
# mutation-engine/llm-call.mjs), and the wf-mcp-server tools that call them
# (wf_propose_mutations, wf_regenerate). Read automatically by the
# @anthropic-ai/sdk client's default env-var fallback — no code changes
# needed once it's set.
ANTHROPIC_API_KEY=sk-ant-...
