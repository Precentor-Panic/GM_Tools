#!/bin/sh
# Move a world's campaign stores into its campaign repo. See bin/campaign-adopt.mjs.
here=$(cd "$(dirname "$0")" && pwd)
conf="$HOME/.config/gm-tools/services.env"
[ -f "$conf" ] && { set -a; . "$conf"; set +a; }
node=${NODE:-$(command -v node || echo "$HOME/.local/node/bin/node")}
exec "$node" "$here/campaign-adopt.mjs" "$@"
