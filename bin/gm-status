#!/bin/sh
# One status command for the whole stack. See bin/gm-status.mjs.
here=$(cd "$(dirname "$0")" && pwd)
conf="$HOME/.config/gm-tools/services.env"
[ -f "$conf" ] && { set -a; . "$conf"; set +a; }
node=${NODE:-$(command -v node || echo "$HOME/.local/node/bin/node")}
exec "$node" "$here/gm-status.mjs" "$@"
