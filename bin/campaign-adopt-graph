#!/bin/sh
# Make a world's campaign repo the owner of its graph. See bin/campaign-adopt-graph.mjs.
here=$(cd "$(dirname "$0")" && pwd)
conf="$HOME/.config/gm-tools/services.env"
[ -f "$conf" ] && { set -a; . "$conf"; set +a; }
node=${NODE:-$(command -v node || echo "$HOME/.local/node/bin/node")}
exec "$node" "$here/campaign-adopt-graph.mjs" "$@"
