review-state/*/
!review-state/.gitkeep

time-skip-status/*/
!time-skip-status/.gitkeep

# The other three flat-file data stores (mutation-engine/human-review.mjs,
# pending-ledger.mjs, user-settings.mjs) follow the same convention as the
# two above but were missing from here -- a real gap found via first hands-on
# use of Phase 8 (toggling rubber-duck mode wrote a real user-settings/
# directory that git status then reported as untracked).
human-review/*
!human-review/.gitkeep

pending-resolution/*/
!pending-resolution/.gitkeep

user-settings/*
!user-settings/.gitkeep

# Phase 10: mutation-engine/entity-narration.mjs, same per-world-subdir
# convention as pending-resolution/ above.
entity-narration/*/
!entity-narration/.gitkeep

# Phase 11: mutation-engine/prep-content.mjs, same per-world-subdir
# convention. Missing here on first landing -- same class of gap already
# caught once for human-review/pending-resolution/user-settings; found again
# via real usage (a real prep-content/wf-test/ directory showing untracked).
prep-content/*/
!prep-content/.gitkeep

# Phase 12: mutation-engine/manual-undo.mjs, flat per-world file like
# human-review/user-settings above. Same recurring class of gap -- every
# new data store in this project has needed this added by hand once real
# usage exercises it for the first time.
manual-undo/*
!manual-undo/.gitkeep

# Phase 16: session-planner/scenes.mjs and session-planner/session-notes.mjs,
# same one-file-per-world flat convention as human-review/user-settings/
# manual-undo above -- added at spec time (task 16.0), not after the fact,
# per this project's own recurring-gap lesson.
session-scenes/*
!session-scenes/.gitkeep

session-notes/*
!session-notes/.gitkeep

# Phase 18 (task 18.0, added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): combat-planning/bestiary-store.mjs is
# PER-ENTRY-FILE, flat under this root (no per-world subdir -- bestiary
# storage is deliberately per-user/library-wide, not per-world, see that
# module's own test file for the reasoning), same convention as
# human-review/*.
bestiary/*
!bestiary/.gitkeep

# combat-planning/party-roster-store.mjs is per-world-file, same convention
# as session-scenes/ above (PCs genuinely belong to one campaign, unlike the
# bestiary).
party-roster/*
!party-roster/.gitkeep

# Phase 22 (task 22.0, added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): mutation-engine/scene-undo.mjs is
# PER-(world,sceneId)-SESSION-FILE under a per-world subdir (same layout as
# review-state/ above), NOT a flat per-world file like manual-undo/ -- it's
# a genuine ordered action-history list scoped to one scene-development
# session, deliberately distinct from manual-undo.mjs's single global slot.
scene-undo/*/
!scene-undo/.gitkeep

# session-planner/scene-membership.mjs is flat per-world-file, same
# convention as session-scenes/ above -- a scene's explicit "add arbitrary
# node" extra-membership list.
scene-membership/*
!scene-membership/.gitkeep

# Phase 22 addendum (added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): combat-planning/saved-encounter.mjs
# is flat per-world-file, same convention as session-notes/ above -- a
# scene's attached, snapshotted "Add Encounter" records.
saved-encounters/*
!saved-encounters/.gitkeep

# Phase 26 task 26.1 (added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): session-planner/plans.mjs is flat
# per-world-file, same convention as session-scenes/ above.
session-plans/*
!session-plans/.gitkeep

node_modules/

# never commit API keys / secrets
.env
.env.*
!.env.example
*.key
