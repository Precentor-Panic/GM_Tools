review-state/*/
!review-state/.gitkeep

time-skip-status/*/
!time-skip-status/.gitkeep

# The other three flat-file data stores (mutation-engine/human-review.mjs,
# pending-ledger.mjs, user-settings.mjs) follow the same convention as the
# two above but were missing from here -- a real gap found via first hands-on
# use of Phase 8 (toggling rubber-duck mode wrote a real user-settings/
# directory that git status then reported as untracked).
human-review/*
!human-review/.gitkeep

pending-resolution/*/
!pending-resolution/.gitkeep

user-settings/*
!user-settings/.gitkeep

# Phase 10: mutation-engine/entity-narration.mjs, same per-world-subdir
# convention as pending-resolution/ above.
entity-narration/*/
!entity-narration/.gitkeep

# Phase 11: mutation-engine/prep-content.mjs, same per-world-subdir
# convention. Missing here on first landing -- same class of gap already
# caught once for human-review/pending-resolution/user-settings; found again
# via real usage (a real prep-content/wf-test/ directory showing untracked).
prep-content/*/
!prep-content/.gitkeep

# Phase 12: mutation-engine/manual-undo.mjs, flat per-world file like
# human-review/user-settings above. Same recurring class of gap -- every
# new data store in this project has needed this added by hand once real
# usage exercises it for the first time.
manual-undo/*
!manual-undo/.gitkeep

# Phase 16: session-planner/scenes.mjs and session-planner/session-notes.mjs,
# same one-file-per-world flat convention as human-review/user-settings/
# manual-undo above -- added at spec time (task 16.0), not after the fact,
# per this project's own recurring-gap lesson.
session-scenes/*
!session-scenes/.gitkeep

session-notes/*
!session-notes/.gitkeep

# Phase 18 (task 18.0, added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): combat-planning/bestiary-store.mjs is
# PER-ENTRY-FILE, flat under this root (no per-world subdir -- bestiary
# storage is deliberately per-user/library-wide, not per-world, see that
# module's own test file for the reasoning), same convention as
# human-review/*.
bestiary/*
!bestiary/.gitkeep

# combat-planning/party-roster-store.mjs is per-world-file, same convention
# as session-scenes/ above (PCs genuinely belong to one campaign, unlike the
# bestiary).
party-roster/*
!party-roster/.gitkeep

# Phase 22 (task 22.0, added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): mutation-engine/scene-undo.mjs is
# PER-(world,sceneId)-SESSION-FILE under a per-world subdir (same layout as
# review-state/ above), NOT a flat per-world file like manual-undo/ -- it's
# a genuine ordered action-history list scoped to one scene-development
# session, deliberately distinct from manual-undo.mjs's single global slot.
scene-undo/*/
!scene-undo/.gitkeep

# session-planner/scene-membership.mjs (Phase 22) was flat per-world-file,
# same convention as session-scenes/ above -- a scene's explicit "add
# arbitrary node" extra-membership list. RETIRED Phase 33 task 33.1 (scene
# contents unified as scene-elements) -- the module is deleted; this rule
# stays only to keep any pre-existing local data dir out of git, never
# written to again.
scene-membership/*
!scene-membership/.gitkeep

# Phase 22 addendum (added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): combat-planning/saved-encounter.mjs
# is flat per-world-file, same convention as session-notes/ above -- a
# scene's attached, snapshotted "Add Encounter" records.
saved-encounters/*
!saved-encounters/.gitkeep

# Phase 26 task 26.1 (added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): session-planner/plans.mjs is flat
# per-world-file, same convention as session-scenes/ above.
session-plans/*
!session-plans/.gitkeep

# Phase 26 task 26.3 (added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): session-planner/scene-links.mjs is
# flat per-world-file, same convention as session-plans/ above. Phase 28
# task 28.1 deleted that module -- this directory's ignore rule stays (any
# real leftover scene-links/ data from before the scrap is harmless and
# still ignored); the module scrap itself is handled in session-planner/.
scene-links/*
!scene-links/.gitkeep

# Phase 28 task 28.1 (added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): session-planner/scene-elements.mjs is
# flat per-world-file, same convention as session-plans/ above.
scene-elements/*
!scene-elements/.gitkeep

# session-planner/scene-narration.mjs is per-(world,sceneId)-file under a
# per-world subdir, same convention as entity-narration/ above.
scene-narration/*/
!scene-narration/.gitkeep

# Session Wrap workstream: session-planner/truth-notes.mjs is per-(world,
# planId)-file under a per-world subdir, same convention as
# scene-narration/ above -- added at spec time (not after the fact), per
# this project's own recurring "new store, missing .gitignore entry" gap
# (called out five times over in this file's own history above).
truth-notes/*/
!truth-notes/.gitkeep
# Aureus table wave B1: session-planner/foundry-orphans.mjs is one-file-per-
# world (human-review convention) -- the stale-scene sweep's work queue.
foundry-orphans/*.json

# Phase 35 task 35.1 (added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): combat-planning/item-store.mjs,
# session-planner/stagecraft-store.mjs, session-planner/token-store.mjs, and
# session-planner/scene-tray.mjs are all flat per-world-file stores, same
# convention as session-scenes/ above.
items/*
!items/.gitkeep

stagecraft/*
!stagecraft/.gitkeep

tokens/*
!tokens/.gitkeep

scene-tray/*
!scene-tray/.gitkeep

# Phase 34's foundry-connection sync-log (per-world JSON, written by the
# sync-now route) -- missed at 34.1 spec time, surfaced by Russell's first
# real "Sync now" click during his Phase-35 pass (the recurring new-store
# gitignore gap, one more time).
foundry-sync-log/

# Phase 37 task 37.1 (added at spec time, not after the fact -- per this
# project's own recurring-gap lesson): session-planner/world-clock.mjs and
# session-planner/fortune-track.mjs are flat per-world-file stores, same
# convention as session-scenes/ above; session-planner/chronicle-run.mjs is
# a per-batch file under a per-world subdir, same convention as
# pending-resolution/ above.
world-clock/*
!world-clock/.gitkeep

fortune-track/*
!fortune-track/.gitkeep

chronicle-run/*/
!chronicle-run/.gitkeep

node_modules/

# never commit API keys / secrets
.env
.env.*
!.env.example
*.key

# Design-handoff source zip (extracted into design/ — the zip itself is redundant)
/TTRPG Session Planning Tool.zip

# Owned rulebook archives + extracted rules library — NEVER commit (IP)
/Core Books-*.zip
/Draw Steel-*.zip
/rules-library/
briefing/
# Seeded design-canvas output (2MB generated payload; re-seed from the
# committed .dc.html + canvas.json working files)
design/session-planner/variants-canvas/run-variants.html
