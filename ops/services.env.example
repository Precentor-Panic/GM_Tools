# Machine configuration for the three services in ops/systemd/.
# Copy to ~/.config/gm-tools/services.env and edit. Secrets (API keys, the
# bridge user's Foundry password) stay in the repo-root .env, not here.

# Absolute path to node (it is often not on a service's PATH).
NODE=/usr/bin/node

# Foundry: its main.js, its data path (the folder that CONTAINS Data/), the
# port, and the world to open at start (leave empty for the setup screen).
FOUNDRY_MAIN=/path/to/foundryvtt/main.js
FOUNDRY_DATA=/path/to/foundrydata
FOUNDRY_PORT=30000
FOUNDRY_WORLD=

# GM_Tools checkout, and the world the bridge client joins.
GM_TOOLS_DIR=/path/to/GM_Tools
WF_WORLD=
WF_DATA_DIR=/path/to/foundrydata/Data
